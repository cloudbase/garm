          "legendFormat": "valid={{valid}} {{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 313,
      "type": "timeseries",
      "title": "Runner deletion time (p95)",
      "description": "Time from deletion decision to full removal. Long tails mean stuck provider deletes \u2014 leaked compute that costs money.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "gradientMode": "opacity",
            "axisSoftMin": 0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
