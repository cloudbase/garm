        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(garm_job_completed_total{conclusion=\"success\", owner=~\"$owner\"}[24h])) / sum(increase(garm_job_completed_total{owner=~\"$owner\"}[24h]))",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 107,
      "type": "heatmap",
      "title": "Job queue time distribution",
      "description": "Distribution of time jobs spend waiting for a runner. A bright band at the bottom is healthy (warm idle runners); mass drifting upward means jobs are waiting on cold boots.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "calculate": false,
        "cellGap": 2,
        "color": {
          "mode": "scheme",
          "scheme": "Blues",
          "steps": 64,
          "fill": "dark-blue",
          "exponent": 0.5,
          "reverse": false
        },
        "yAxis": {
          "unit": "s",
          "axisPlacement": "left",
          "reverse": false
        },
        "rowsFrame": {
          "layout": "auto"
        },
        "tooltip": {
          "mode": "single",
          "showColorScale": true,
          "yHistogram": true
        },
        "legend": {
          "show": true
        },
        "exemplars": {
          "color": "rgba(255,0,255,0.7)"
        },
        "filterValues": {
          "le": 1e-09
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (le) (increase(garm_job_queue_duration_seconds_bucket{owner=~\"$owner\"}[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "refId": "A",
          "format": "heatmap"
        }
      ]
    },
